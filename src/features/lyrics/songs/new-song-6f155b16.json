        {
          "original": "Wenn jemand fragt, leugne ich das Emotionsgewicht",
          "translation": "",
          "annotations": []
        },
        {
          "original": "Du warst in meiner Vorgeschichte nur ein Vogelschiss (Mhh)",
          "translation": "",
          "annotations": []
        },
        {
          "original": "Da hängt von uns so ein romantisches Brückenschloss",
          "translation": "",
          "annotations": []
        },
        {
          "original": "Doch Gott sei Dank hab' ich den Schlüssel noch",
          "translation": "",
          "annotations": []
        },
        {
          "original": "Rücksichtslos, auch unser Baumherz küsst Diesel",
          "translation": "",
          "annotations": []
        },
        {
          "original": "Socke übern Rückspiegel",
          "translation": "",
          "annotations": []
        }
