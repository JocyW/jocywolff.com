    {
      "id": "d131b797-032f-4fa5-a5d2-dda031ea8185",
      "type": "verse",
      "label": "Part 2",
      "lines": [
        {
          "original": "Ja, ich lag in deinem Schoß, mal am lachen, mal am heul'n",
          "translation": "",
          "annotations": []
        },
        {
          "original": "Aber hast du dafür Zeugen? What?",
          "translation": "",
          "annotations": []
        },
        {
          "original": "Auf manchen Bildern frohlocke ich wie am Honigtopf",
          "translation": "",
          "annotations": []
        },
        {
          "original": "Doch nicht mehr lange, ich hab' Photoshop, ey",
          "translation": "",
          "annotations": []
        },
        {
          "original": "Du verschwindest, als würdest du das Regime kritisieren",
          "translation": "",
          "annotations": []
        },
        {
          "original": "Hast nie existiert, Geschichte wird von Siegern geschrieben",
          "translation": "",
          "annotations": []
